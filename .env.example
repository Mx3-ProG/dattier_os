ATACUISINE_DEMO=true
# Local only. Never enable this adapter on Vercel.
ATACUISINE_DATA_DIR=.data/atacuisine-demo

# Cuisine IA : sans clé, seul le moteur réflexe répond (aucun coût fournisseur).
ANTHROPIC_API_KEY=
# Fournisseur IA (anthropic par défaut, ou openai-compatible pour Ollama/Mistral/Groq…).
# AI_PROVIDER=anthropic
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.3:70b
# Modèle et marge appliquée au coût réel (crédits = coût × marge / 0,02 €).
ATACUISINE_AI_MODEL=claude-opus-5-5
ATACUISINE_AI_MARKUP=8
