# Copy to .env.production. Never commit actual values. Passwords here must be URL-safe.
APP_URL=https://atacuisine.example.com
IDENTITY_URL=https://identity.example.com
# CSP des pages : report-only observe sans bloquer, enforce bloque. Voir docs/platform/SELF_HOSTING.md.
CSP_MODE=report-only
SOURCE_URL=https://github.com/Mx3-ProG/dattier_os
ATACUISINE_DEMO=false
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
IDENTITY_DB_PASSWORD=
KEYCLOAK_ADMIN=operator
KEYCLOAK_ADMIN_PASSWORD=
SESSION_SECRET=
INTEGRATION_ENCRYPTION_KEY=
GARAGE_RPC_SECRET=
# Garage access keys use GK followed by 32 hexadecimal characters.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=atacuisine

# Cuisine IA : sans clé, seul le moteur réflexe répond (aucun coût fournisseur).
ANTHROPIC_API_KEY=
# Modèle et marge appliquée au coût réel (crédits = coût × marge / 0,02 €).
ATACUISINE_AI_MODEL=claude-opus-5-5
ATACUISINE_AI_MARKUP=8

# Messages clients (email / SMS en un clic depuis l’écran Clients).
# Sans ces clés, les envois sont tracés en « mode démo » et rien ne part.
RESEND_API_KEY=
EMAIL_FROM=contact@votre-domaine.fr
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro Twilio ou identifiant alphanumérique (11 caractères max), ex. +33700000000
TWILIO_FROM=

# Paiements en ligne (Stripe Connect). Utiliser une clé de test ou d'un sandbox.
# Une clé réelle reste refusée tant que la ligne de validation n'est pas à true :
# ne l'activer qu'après validation juridique et comptable du circuit.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ATACUISINE_STRIPE_LIVE_APPROVED=false
# Points de base : 700 = 7 %. Le délai est un choix interne, pas une obligation légale.
ATACUISINE_COMMISSION_BP=700
ATACUISINE_STRIPE_FEE_BP=300
ATACUISINE_PAYOUT_HOLD_DAYS=31

# Groupes de workers (facultatif). Voir docs/platform/WORKER_GROUPS.md.
# APP_DB_POOL_SIZE=20
# WORKER_CRITICAL_CPUS=1
# WORKER_CRITICAL_MEMORY=512m
# WORKER_MAINTENANCE_CPUS=1
# WORKER_MAINTENANCE_MEMORY=512m
# WORKER_MEDIA_CPUS=2
# WORKER_MEDIA_MEMORY=2g
# Independent monthly feature add-ons (Stripe test Price IDs, each 9 EUR HT/month).
STUDIO_ADDON_INVOICES_PRICE_ID=
STUDIO_ADDON_ATTENDANCE_PRICE_ID=
STUDIO_ADDON_CLIENT_INVOICES_PRICE_ID=
STUDIO_ADDON_PAYROLL_PRICE_ID=
STUDIO_ADDON_OFFLINE_CONFLICTS_PRICE_ID=
STUDIO_ADDON_CONNECTIONS_PRICE_ID=
STUDIO_ADDON_QR_PRICE_ID=
STUDIO_ADDON_LOYALTY_PRICE_ID=
STUDIO_ADDON_DOMAIN_PRICE_ID=
STUDIO_ADDON_CLICK_COLLECT_PREMIUM_PRICE_ID=

# Hébergement Vercel : identité Supabase Auth (utilisée quand OIDC_ISSUER est vide).
# Clé publiable (sb_publishable_…) ou ancienne clé anon : publique par conception.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Abonnement mensuel Studio (Stripe Checkout). Compte SaaS distinct de Stripe Connect.
# Clé live acceptée pour l'abonnement principal ; les add-ons restent en mode test.
STUDIO_PLAN_STRIPE_SECRET_KEY=
STUDIO_PLAN_STRIPE_WEBHOOK_SECRET=
STUDIO_PLAN_PRICE_ID=
# true seulement si Stripe Tax est configuré (adresse d'origine, enregistrements).
STUDIO_PLAN_AUTOMATIC_TAX=false
# Rôle membre de atacuisine_addon_billing : seul autorisé à activer un forfait payé.
STUDIO_BILLING_DATABASE_URL=
